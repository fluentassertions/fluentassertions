<Project>

  <!--
    Copies SKILL.md and .gitignore from this package to .agents/skills/fluentassertions/ in the consuming repo root.
    Uses InitializeSourceControlInformation (SourceLink) to locate the repo root.
    Falls back to SolutionDir if the git root cannot be determined.
    Falls back to the directory containing the nearest AGENTS.md file found above the project file.
    Silently skips if the base directory cannot be determined.
    Copies both files or neither, and never overwrites a SKILL.md that Fluent Assertions did not generate
    (recognized by the .gitignore that comes with it).
    When projects reference different versions of Fluent Assertions, the newest version wins.
    Opt-out: set <FluentAssertionsSkill>false</FluentAssertionsSkill> in your project or Directory.Build.props.
  -->
  <Target Name="CopyFluentAssertionsSkill"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="InitializeSourceControlInformation"
          Condition="'$(FluentAssertionsSkill)' != 'false'">

    <ItemGroup>
      <_FluentAssertionsSkillSourceRoot Include="@(SourceRoot -> WithMetadataValue('SourceControl', 'git'))" />
    </ItemGroup>

    <PropertyGroup>
      <_FluentAssertionsSkillRepoRoot>@(_FluentAssertionsSkillSourceRoot)</_FluentAssertionsSkillRepoRoot>
      <_FluentAssertionsSkillRepoRoot Condition="'$(_FluentAssertionsSkillRepoRoot)' == '' and '$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</_FluentAssertionsSkillRepoRoot>
      <_FluentAssertionsSkillAgentsMd Condition="'$(_FluentAssertionsSkillRepoRoot)' == ''">$([MSBuild]::GetPathOfFileAbove('AGENTS.md', '$(MSBuildProjectDirectory)'))</_FluentAssertionsSkillAgentsMd>
      <_FluentAssertionsSkillRepoRoot Condition="'$(_FluentAssertionsSkillRepoRoot)' == '' and '$(_FluentAssertionsSkillAgentsMd)' != ''">$([System.IO.Path]::GetDirectoryName('$(_FluentAssertionsSkillAgentsMd)'))\</_FluentAssertionsSkillRepoRoot>
      <_FluentAssertionsSkillSource>$(MSBuildThisFileDirectory)..\skills\fluentassertions\</_FluentAssertionsSkillSource>
      <_FluentAssertionsSkillTarget Condition="'$(_FluentAssertionsSkillRepoRoot)' != ''">$(_FluentAssertionsSkillRepoRoot).agents\skills\fluentassertions\</_FluentAssertionsSkillTarget>
    </PropertyGroup>

    <!-- The target folder is ours if it has no SKILL.md yet, or if it contains the .gitignore we generate. -->
    <PropertyGroup Condition="'$(_FluentAssertionsSkillTarget)' != ''">
      <_FluentAssertionsSkillExistingGitignore Condition="Exists('$(_FluentAssertionsSkillTarget).gitignore')">$([System.IO.File]::ReadAllText('$(_FluentAssertionsSkillTarget).gitignore'))</_FluentAssertionsSkillExistingGitignore>
      <_FluentAssertionsSkillOwnsTarget Condition="!Exists('$(_FluentAssertionsSkillTarget)SKILL.md')">true</_FluentAssertionsSkillOwnsTarget>
      <_FluentAssertionsSkillOwnsTarget Condition="$(_FluentAssertionsSkillExistingGitignore.Contains('generated by Fluent Assertions'))">true</_FluentAssertionsSkillOwnsTarget>
      <_FluentAssertionsSkillCanCopy Condition="'$(_FluentAssertionsSkillOwnsTarget)' == 'true' and Exists('$(_FluentAssertionsSkillSource)SKILL.md') and Exists('$(_FluentAssertionsSkillSource).gitignore')">true</_FluentAssertionsSkillCanCopy>
    </PropertyGroup>

    <!--
      Projects in the same repository can reference different versions of Fluent Assertions.
      The version of this package is the name of its folder in the NuGet packages folder (<id>/<version>/buildTransitive/).
      The .version file in the target folder records which version wrote the skill, and an older version never replaces
      the skill of a newer one, so the result does not depend on the build order.
    -->
    <PropertyGroup Condition="'$(_FluentAssertionsSkillCanCopy)' == 'true'">
      <_FluentAssertionsSkillVersionPattern>^\d+(\.\d+){1,3}([-+].*)?$</_FluentAssertionsSkillVersionPattern>
      <_FluentAssertionsSkillVersion>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(MSBuildThisFileDirectory)'))))))</_FluentAssertionsSkillVersion>
      <_FluentAssertionsSkillVersion Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_FluentAssertionsSkillVersion)', '$(_FluentAssertionsSkillVersionPattern)'))"></_FluentAssertionsSkillVersion>
      <_FluentAssertionsSkillExistingVersion Condition="Exists('$(_FluentAssertionsSkillTarget).version')">$([System.IO.File]::ReadAllText('$(_FluentAssertionsSkillTarget).version').Trim())</_FluentAssertionsSkillExistingVersion>
      <_FluentAssertionsSkillExistingVersion Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_FluentAssertionsSkillExistingVersion)', '$(_FluentAssertionsSkillVersionPattern)'))"></_FluentAssertionsSkillExistingVersion>
      <_FluentAssertionsSkillCanCopy Condition="'$(_FluentAssertionsSkillVersion)' != '' and '$(_FluentAssertionsSkillExistingVersion)' != '' and $([MSBuild]::VersionLessThan('$(_FluentAssertionsSkillVersion)', '$(_FluentAssertionsSkillExistingVersion)'))">false</_FluentAssertionsSkillCanCopy>
    </PropertyGroup>

    <MakeDir Directories="$(_FluentAssertionsSkillTarget)"
             Condition="'$(_FluentAssertionsSkillCanCopy)' == 'true'"
             ContinueOnError="true" />

    <!--
      The .gitignore goes first, so a generated SKILL.md never shows up as a change in source control.
      Projects that build in parallel can copy at the same time. SkipUnchangedFiles makes all but the first one skip the
      copy, the retries handle a file that another project is still writing, and a failure never breaks the build.
    -->
    <Copy SourceFiles="$(_FluentAssertionsSkillSource).gitignore;$(_FluentAssertionsSkillSource)SKILL.md"
          DestinationFiles="$(_FluentAssertionsSkillTarget).gitignore;$(_FluentAssertionsSkillTarget)SKILL.md"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
          Condition="'$(_FluentAssertionsSkillCanCopy)' == 'true'"
          ContinueOnError="true" />

    <WriteLinesToFile File="$(_FluentAssertionsSkillTarget).version"
                      Lines="$(_FluentAssertionsSkillVersion)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'$(_FluentAssertionsSkillCanCopy)' == 'true' and '$(_FluentAssertionsSkillVersion)' != ''"
                      ContinueOnError="true" />

  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutRootDirectory>..\</FalloutRootDirectory>
    <FalloutScriptDirectory>..\</FalloutScriptDirectory>
    <FalloutVersion>10.4.0</FalloutVersion>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="GitVersion.Tool" Version="[6.8.2]" />
    <PackageDownload Include="ReportGenerator" Version="[5.5.10]" />
    <PackageDownload Include="xunit.runner.console" Version="[2.9.3]" />
    <PackageDownload Include="PackageGuard" Version="[2.5.1]" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="Fallout.Common" Version="$(FalloutVersion)" />
    <PackageReference Include="Fallout.Components" Version="$(FalloutVersion)" />
    <!-- Upstream issue: https://github.com/Fallout-build/Fallout/issues/638 -->
    <PackageReference Include="NuGet.Frameworks" Version="7.9.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
</Project>
